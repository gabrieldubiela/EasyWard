# =========================================================
# EASYWARD — VARIÁVEIS DE AMBIENTE
# =========================================================
#
# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env
#
# NUNCA commite o arquivo .env no repositório.
# Este arquivo (.env.example) deve ser commitado SEM valores reais.
#
# Documentação completa: docs/deploy.md e docs/seguranca.md
# =========================================================


# ---------------------------------------------------------
# AMBIENTE
# ---------------------------------------------------------

# Ambiente de execução: development | production | test
APP_ENV=development


# ---------------------------------------------------------
# BANCO DE DADOS
# ---------------------------------------------------------

# String de conexão PostgreSQL (Supabase)
# Formato: postgresql+asyncpg://usuario:senha@host:porta/banco
# Encontrar em: Supabase → Project Settings → Database → Connection string (URI)
# Atenção: usar a versão com +asyncpg para o SQLAlchemy assíncrono
DATABASE_URL=postgresql+asyncpg://postgres:[senha]@db.[projeto].supabase.co:5432/postgres


# ---------------------------------------------------------
# AUTENTICAÇÃO JWT
# ---------------------------------------------------------

# Chave secreta para assinar access tokens (30 min)
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Chave secreta para assinar refresh tokens (7 dias)
# Deve ser diferente do JWT_SECRET
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_REFRESH_SECRET=


# ---------------------------------------------------------
# JOBS AUTOMÁTICOS
# ---------------------------------------------------------

# Token fixo para autenticar chamadas do GitHub Actions ao endpoint /jobs
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
JOB_SECRET=


# ---------------------------------------------------------
# CORS
# ---------------------------------------------------------

# Origens permitidas para requisições CORS (separadas por vírgula)
# Em desenvolvimento: http://localhost:5173
# Em produção: URL do frontend no Vercel
CORS_ORIGINS=http://localhost:5173


# ---------------------------------------------------------
# E-MAIL — RESEND
# ---------------------------------------------------------

# Chave de API do Resend
# Obter em: resend.com → API Keys
RESEND_API_KEY=

# E-mail remetente (deve ser de um domínio verificado no Resend)
# Em desenvolvimento pode usar: onboarding@resend.dev (domínio de teste do Resend)
RESEND_FROM_EMAIL=noreply@seudominio.com


# ---------------------------------------------------------
# NOTIFICAÇÕES PUSH — FIREBASE (FCM)
# ---------------------------------------------------------

# JSON de credenciais do Firebase Admin SDK (service account)
# Obter em: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Colar o conteúdo do arquivo JSON aqui em uma linha (ou usar o caminho do arquivo)
# Em desenvolvimento: deixar vazio para desabilitar push
FIREBASE_CREDENTIALS=


# ---------------------------------------------------------
# MONITORAMENTO — SENTRY
# ---------------------------------------------------------

# DSN do projeto no Sentry
# Obter em: sentry.io → Project Settings → Client Keys (DSN)
# Em desenvolvimento: deixar vazio para não reportar erros ao Sentry
SENTRY_DSN=


# =========================================================
# FRONTEND — variáveis com prefixo VITE_
# (usadas apenas no frontend, expostas ao cliente)
# =========================================================

# URL base da API backend
# Em desenvolvimento: http://localhost:8000/api/v1
# Em produção: URL do Render
VITE_API_URL=http://localhost:8000/api/v1

# Ambiente do frontend
VITE_APP_ENV=development

# ---------------------------------------------------------
# FIREBASE — configuração do cliente (frontend)
# Obter em: Firebase Console → Project Settings → Seus aplicativos → Web
# ---------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chave VAPID para notificações push web (PWA)
# Obter em: Firebase Console → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=


# =========================================================
# GITHUB ACTIONS — secrets (não ficam no .env)
# =========================================================
#
# Os seguintes valores devem ser configurados como Secrets
# no repositório GitHub (Settings → Secrets and variables → Actions):
#
#   DATABASE_URL      → mesma string acima (do Supabase produção)
#   JWT_SECRET        → mesma string acima
#   JWT_REFRESH_SECRET → mesma string acima
#   JOB_SECRET        → mesma string acima
#   API_URL           → URL do backend no Render (ex: https://easyward-api.onrender.com)
#   RCLONE_CONFIG     → conteúdo do arquivo ~/.config/rclone/rclone.conf (para backup)
#
# =========================================================
